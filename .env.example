# 로컬 개발용 예시. 실제 값이 담긴 .env 는 커밋하지 않는다(.gitignore 등록됨).
# 운영 환경에서는 이 파일을 쓰지 않고 운영자가 ConfigMap/Secret 으로 주입한다.

# [필수] PostgreSQL 접속 정보
DATABASE_URL=postgresql://duty_app:changeme@localhost:5432/duty

# [선택] 관리자 키. 값을 넣으면 그때부터 수정 API가 X-Admin-Key 헤더를 요구한다.
#        비워 두면 사내망 사용자 누구나 수정 가능(현 정책).
ADMIN_KEY=

# [선택] 기본값이 있어 생략 가능
APP_PORT=8080
DB_POOL_MIN=1
DB_POOL_MAX=5
LOG_LEVEL=INFO
